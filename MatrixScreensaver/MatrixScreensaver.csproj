<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MatrixScreensaver</AssemblyName>
    <RootNamespace>MatrixScreensaver</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSingleFilePublish>true</IncludeNativeLibrariesForSingleFilePublish>
    <IncludeWindowsSDKRefFrameworkReferences>false</IncludeWindowsSDKRefFrameworkReferences>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- No PDB files in release builds for our own assembly -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- Delete the native PDB shipped by SkiaSharp.NativeAssets.Win32 (~80 MB, debug symbols,
       not needed at runtime). Must run AfterTargets="Publish" because the file is written to
       the publish dir by a NuGet native-copy pipeline that bypasses _ResolvedFileToPublish. -->
  <Target Name="RemoveNativePdbs" AfterTargets="Publish">
    <ItemGroup>
      <_NativePdbs Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_NativePdbs)" />
  </Target>

  <ItemGroup>
    <!-- SkiaSharp core rendering library -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.Views.WindowsForms" Version="3.119.4" />
  </ItemGroup>

</Project>